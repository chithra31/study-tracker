# Copy this file to .env and fill in the values.

# PostgreSQL connection string. Create the database first (see the root README).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/study_tracker"

# Secret used to sign login tokens. Use any long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: enables the AI-written weekly review. Without it, the app uses a built-in rule-based review.
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model used for the weekly review (default: claude-opus-5-5).
# ANTHROPIC_MODEL="claude-haiku-5-5"
